@model SkillSwapAI.Models.Exam
@{
    ViewData["Title"] = "Take Exam";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card p-5 shadow-lg">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <div>
                    <h2 class="mb-1">@Model.Title</h2>
                    <p class="text-muted mb-0">Total Questions: @Model.Questions.Count</p>
                </div>
                <div id="timer" class="h4 text-warning fw-bold"></div>
            </div>

            <form asp-action="SubmitExam" method="post">
                <input type="hidden" name="examId" value="@Model.Id" />
                
                @foreach (var (q, index) in Model.Questions.Select((v, i) => (v, i)))
                {
                    <div class="question-block mb-5">
                        <h5 class="mb-4">@(index + 1). @q.Text</h5>
                        <div class="options-grid">
                            <div class="form-check custom-option p-0 mb-3">
                                <input type="radio" class="btn-check" name="q_@q.Id" id="q_@q.Id_A" value="A" required>
                                <label class="btn btn-outline-secondary w-100 text-start p-3" for="q_@q.Id_A">
                                    <span class="me-2 fw-bold">A.</span> @q.OptionA
                                </label>
                            </div>
                            <div class="form-check custom-option p-0 mb-3">
                                <input type="radio" class="btn-check" name="q_@q.Id" id="q_@q.Id_B" value="B">
                                <label class="btn btn-outline-secondary w-100 text-start p-3" for="q_@q.Id_B">
                                    <span class="me-2 fw-bold">B.</span> @q.OptionB
                                </label>
                            </div>
                            <div class="form-check custom-option p-0 mb-3">
                                <input type="radio" class="btn-check" name="q_@q.Id" id="q_@q.Id_C" value="C">
                                <label class="btn btn-outline-secondary w-100 text-start p-3" for="q_@q.Id_C">
                                    <span class="me-2 fw-bold">C.</span> @q.OptionC
                                </label>
                            </div>
                            <div class="form-check custom-option p-0 mb-3">
                                <input type="radio" class="btn-check" name="q_@q.Id" id="q_@q.Id_D" value="D">
                                <label class="btn btn-outline-secondary w-100 text-start p-3" for="q_@q.Id_D">
                                    <span class="me-2 fw-bold">D.</span> @q.OptionD
                                </label>
                            </div>
                        </div>
                    </div>
                    <hr class="opacity-10">
                }

                <div class="text-center mt-5">
                    <button type="submit" class="btn btn-primary btn-lg px-5 py-3 shadow">Submit Final Answers</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .btn-check:checked + .btn-outline-secondary {
            background-color: var(--primary);
            border-color: var(--primary);
            color: white;
            box-shadow: 0 0 15px rgba(99, 102, 241, 0.3);
        }
    </style>
}
