@model List<SkillSwapAI.Models.Exam>
@{
    ViewData["Title"] = "Available Exams";
}

<div class="mb-5 text-center">
    <h1 class="display-4 fw-bold">Validate Your <span class="text-primary">Skills</span></h1>
    <p class="text-muted">Pass these exams with 70% or higher to earn a certificate.</p>
</div>

<div class="row g-4">
    @foreach (var exam in Model)
    {
        <div class="col-md-4">
            <div class="card h-100 p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="rounded bg-primary bg-opacity-10 p-3">
                        <i class="fas fa-file-alt fa-2x text-primary"></i>
                    </div>
                    <span class="badge bg-dark text-primary border border-primary">@exam.Skill.Name</span>
                </div>
                <h4>@exam.Title</h4>
                <p class="text-muted small">Test your knowledge in @exam.Skill.Name and earn your digital badge.</p>
                <div class="mt-auto">
                    <a asp-action="TakeExam" asp-route-id="@exam.Id" class="btn btn-outline-primary w-100">Start Exam</a>
                </div>
            </div>
        </div>
    }
</div>
