@using SkillSwapAI.Models
@using SkillSwapAI.Controllers
@{
    ViewData["Title"] = "Student Dashboard";
    var user = ViewBag.User as User;
    var matches = ViewBag.Matches as List<MatchViewModel>;
    var leaderboard = ViewBag.Leaderboard as List<Result>;
}

<div class="row g-4">
    <!-- Profile & Skills -->
    <div class="col-lg-4">
        <div class="card p-4 h-100">
            <div class="text-center mb-4">
                <div class="rounded-circle bg-primary d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <i class="fas fa-user fa-3x text-white"></i>
                </div>
                <h3>@user.Name</h3>
                <p class="text-muted">@user.Email</p>
                <span class="badge bg-primary">Student</span>
            </div>
            
            <hr class="opacity-10">
            
            <h5>Your Skills</h5>
            <div class="mb-3">
                <p class="small text-muted mb-2">Teaching:</p>
                @foreach (var us in user.UserSkills.Where(s => s.IsTeaching))
                {
                    <span class="badge border border-success text-success mb-1 me-1">@us.Skill.Name</span>
                }
            </div>
            <div>
                <p class="small text-muted mb-2">Learning:</p>
                @foreach (var us in user.UserSkills.Where(s => !s.IsTeaching))
                {
                    <span class="badge border border-info text-info mb-1 me-1">@us.Skill.Name</span>
                }
            </div>
        </div>
    </div>

    <!-- AI Matches -->
    <div class="col-lg-8">
        <div class="card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0"><i class="fas fa-wand-magic-sparkles text-warning me-2"></i>AI Skill Matches</h4>
                <small class="text-muted">Ranked by expertise</small>
            </div>
            
            @if (matches != null && matches.Any())
            {
                <div class="row g-3">
                    @foreach (var match in matches)
                    {
                        <div class="col-md-6">
                            <div class="p-3 rounded glass d-flex align-items-center">
                                <div class="flex-shrink-0 me-3">
                                    <div class="rounded bg-dark p-2">
                                        <i class="fas fa-graduation-cap text-primary"></i>
                                    </div>
                                </div>
                                <div>
                                    <h6 class="mb-0">@match.UserName</h6>
                                    <p class="small text-muted mb-0">Can teach: <strong>@match.SkillName</strong></p>
                                    <span class="badge bg-opacity-25 bg-primary text-primary small">@match.Level</span>
                                </div>
                                <button class="btn btn-sm btn-primary ms-auto"><i class="fas fa-paper-plane"></i></button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <p class="text-muted">No matches found yet. Add more skills to learn!</p>
                </div>
            }
        </div>

        <!-- Leaderboard -->
        <div class="card p-4">
            <h4 class="mb-4"><i class="fas fa-trophy text-warning me-2"></i>Top Learners</h4>
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Student</th>
                            <th>Score</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var r in leaderboard)
                        {
                            <tr>
                                <td>
                                    @if(i <= 3) { <i class="fas fa-medal @(i==1?"text-warning":(i==2?"text-secondary":"text-bronze"))"></i> }
                                    @i
                                </td>
                                <td>@r.User.Name</td>
                                <td>
                                    <div class="progress" style="height: 10px; width: 100px;">
                                        <div class="progress-bar bg-primary" style="width: @((double)r.Score/r.TotalQuestions * 100)%"></div>
                                    </div>
                                    <small>@r.Score / @r.TotalQuestions</small>
                                </td>
                                <td class="text-muted small">@r.TakenAt.ToString("MMM dd")</td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
